{
  "expo": {
    "name": "DocuALL",
    "slug": "docuall",
    "scheme": "docuall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docuall.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DocuALL needs the camera to scan documents.",
        "NSPhotoLibraryUsageDescription": "DocuALL needs photo access to import pages and save exported PDFs.",
        "NSPhotoLibraryAddUsageDescription": "DocuALL saves exported PDFs and scans to your photo library when you choose to."
      }
    },
    "android": {
      "package": "com.docuall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EC"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-mail-composer",
      [
        "expo-camera",
        {
          "cameraPermission": "DocuALL uses your camera to scan documents.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DocuALL needs photo access to import pages.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://docuall.baddadllc.net"
    },
    "newArchEnabled": true
  }
}
